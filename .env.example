# Optional: Wi-Fi IP and port, or the HTTPS domain students can open.
# Leave empty to use the request host (or detect the LAN IP for localhost).
PUBLIC_BASE_URL=
ATTENDANCE_TIMEZONE=Asia/Almaty
PORT=5000
# Set a long random value for a stable login session across server restarts.
SECRET_KEY=

# Production bootstrap only creates missing accounts; never commit real values.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TEACHER_PASSWORD=
BOOTSTRAP_STUDENT_PASSWORD=
